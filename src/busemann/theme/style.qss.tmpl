/* Busemann stylesheet template. Every value comes from theme/tokens.py via string.Template. */

QWidget {
    font-family: "$font_ui", "$font_ui_fallback";
    font-size: ${size_base}px;
    color: $text;
}

QMainWindow, #canvasHost {
    background: $bg;
}

#leftPanel, #rightPanel, #rightScroll, #panelBody {
    background: $surface;
}

#leftPanel { border-right: ${border_w}px solid $border; }
#rightPanel { border-left: ${border_w}px solid $border; }
#rightPanel::pane { border: none; }
#verificationCard {
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    background: $surface;
}
#verificationCard[level="warn"] { border-color: $warn; }
#verificationCard[level="error"] { border-color: $error; }
#verificationText { color: $text; font-size: ${size_label}px; }
#verificationSource {
    color: $text_muted;
    font-family: "$font_mono", "$font_mono_fallback";
    font-size: ${size_label}px;
}
#verificationQuote { color: $text_muted; font-size: ${size_label}px; font-style: italic; }

QScrollArea { border: none; background: $surface; }

#sectionTitle {
    font-size: ${size_label}px;
    font-weight: 600;
    color: $text_muted;
    padding-top: ${s1}px;
}

#fieldLabel, #kpiTitle, #readoutLabel {
    font-size: ${size_label}px;
    color: $text_muted;
}

#muted { color: $text_muted; font-size: ${size_label}px; }
#chartLegend { color: $text_muted; font-size: ${size_label}px; }

#unit, #readoutUnit {
    font-family: "$font_mono", "$font_mono_fallback";
    font-size: ${size_label}px;
    color: $text_muted;
}

#readoutValue {
    font-family: "$font_mono", "$font_mono_fallback";
    color: $text;
}

#divider { background: $border; max-height: ${border_w}px; min-height: ${border_w}px; }

/* --- inputs --------------------------------------------------------- */

QLineEdit {
    font-family: "$font_mono", "$font_mono_fallback";
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    padding: 3px ${s1}px;
    selection-background-color: $accent;
}
QLineEdit:focus { border-color: $accent; }
QLineEdit[invalid="true"] { border-bottom: 2px solid $error; }
QLineEdit:read-only { background: $bg; color: $text_muted; }

#fieldError { color: $error; font-size: ${size_label}px; }

QComboBox {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    padding: 3px ${s1}px;
}
QComboBox:focus { border-color: $accent; }
QComboBox::drop-down { border: none; width: ${s3}px; }
QComboBox::down-arrow { image: url("$chevron_down"); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background: $surface;
    border: ${border_w}px solid $border;
    selection-background-color: $accent;
    selection-color: $surface;
}

QSlider::groove:horizontal { height: 4px; background: $border; border-radius: 2px; }
QSlider::sub-page:horizontal { background: $accent; border-radius: 2px; }
QSlider::handle:horizontal {
    background: $surface;
    border: 2px solid $accent;
    width: 12px; height: 12px;
    margin: -6px 0;
    border-radius: 7px;
}

/* --- segmented control ---------------------------------------------- */

#segment {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: 0px;
    padding: 4px ${s1}px;
    min-height: 18px;
    color: $text;
}
#segment[first="true"] { border-top-left-radius: ${radius}px; border-bottom-left-radius: ${radius}px; }
#segment[last="true"] { border-top-right-radius: ${radius}px; border-bottom-right-radius: ${radius}px; }
#segment:hover { background: $bg; }
#segment:checked { background: $accent; border-color: $accent; color: $surface; }

#sectionToggle {
    border: none;
    background: transparent;
    text-align: left;
    padding: 2px 0px;
    color: $text_muted;
    font-size: ${size_label}px;
}

/* --- KPI cards ------------------------------------------------------ */

#kpiCard {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
}
#kpiValue {
    font-family: "$font_mono", "$font_mono_fallback";
    font-size: ${size_kpi}px;
    color: $text;
}
#kpiValue[compact="true"] { font-size: 17px; }
#kpiSub { color: $text_muted; font-size: ${size_label}px; }
#kpiNote { color: $text_muted; font-size: ${size_label}px; }
#kpiNote[level="ok"] { color: $ok; }
#kpiNote[level="error"] { color: $error; }
#kpiDelta { color: $text_muted; font-size: ${size_label}px; font-family: "$font_mono", "$font_mono_fallback"; }
#noticeGroup { color: $text_muted; font-size: ${size_label}px; font-weight: 600; }

#warningRow, #infoRow { color: $text; }
#noticeCard {
    border: ${border_w}px solid $warn;
    border-radius: ${radius}px;
    background: $surface;
}
#noticeCard[level="error"] { border-color: $error; }
#noticeCard[level="info"] { border-color: $border; }
#noticeTitle { font-weight: 600; color: $text; }
#noticeTitle[level="error"] { color: $error; }
#errorRow { color: $error; }
#errorText { color: $error; }
#stationTable {
    font-family: "$font_mono", "$font_mono_fallback";
    font-size: ${size_label}px;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    background: $surface;
    selection-background-color: $bg;
    selection-color: $accent;
}
#stationTable QHeaderView::section {
    background: $surface;
    color: $text_muted;
    border: none;
    border-bottom: ${border_w}px solid $border;
    padding: 2px 2px;
    font-size: ${size_label}px;
}
#stationTable::item { padding: 0px; }
#linkButton {
    border: none;
    background: transparent;
    color: $accent;
    font-size: ${size_label}px;
    padding: 0px;
}
#linkButton:hover { text-decoration: underline; }
#explainDrawer {
    background: $surface;
    border-left: ${border_w}px solid $border;
}
#drawerTitle { font-weight: 600; font-size: 15px; color: $text; }
#drawerTopics { color: $text_muted; font-size: ${size_label}px; }
#drawerClose { font-size: 16px; color: $text_muted; }
#explainBody { border: none; background: $surface; }
#welcomeDialog, #welcomeBody { background: $bg; }
#welcomeHeader { background: $surface; border-right: ${border_w}px solid $border; }
#welcomeTitle { color: $text; font-size: ${size_kpi}px; font-weight: 600; }
#welcomeTagline { color: $text; }
#welcomeVersion, #presetSub {
    font-family: "$font_mono", "$font_mono_fallback";
    font-size: ${size_label}px;
    color: $text_muted;
}
#presetCard {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
}
#presetCard:hover, #presetCard:focus { border-color: $accent; }
#presetTitle { color: $text; font-weight: 500; }
#emptyState {
    color: $text_muted;
    font-size: ${size_label}px;
    border: ${border_w}px dashed $border;
    border-radius: ${radius}px;
    background: $surface;
    padding: ${s2}px;
}
#secondaryButton {
    background: $surface;
    color: $text;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    padding: 4px ${s2}px;
}
#secondaryButton:hover { border-color: $accent; color: $accent; }
#secondaryButton:focus { border-color: $accent; }
#secondaryButton:pressed { background: $bg; }
#welcomeList {
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    background: $surface;
}
#welcomeList::item { padding: 6px ${s1}px; border-bottom: ${border_w}px solid $border; }
#welcomeList::item:hover { background: $bg; }
#overlayCard {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
}
#overlayTitle, #placeholderTitle { font-weight: 600; font-size: 15px; color: $text; }
#shortcutKey { color: $text; }
#shortcutAction { color: $text; }
#chip {
    color: $text;
    background: $bg;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    padding: 4px ${s1}px;
}
#regimeBadge {
    font-weight: 600;
    border-radius: ${radius}px;
    padding: 4px ${s1}px;
    min-width: 96px;
    color: $surface;
    background: $text_muted;
}
#regimeBadge[regime="spillage"] { background: $accent; }
#regimeBadge[regime="on-lip"] { background: $ok; }
#regimeBadge[regime="shock-in-duct"] { background: $warn; }
#regimeBadge[regime="detached"] { background: $error; }
#supplyChip {
    font-size: ${size_label}px;
    border-radius: 4px;
    padding: 0px 4px;
    color: $surface;
    background: $ok;
}
#supplyChip[kind="shortfall"] { background: $error; }
#kpiBadge {
    color: $accent;
    font-size: ${size_label}px;
    border: ${border_w}px solid $accent;
    border-radius: 4px;
    padding: 0px 4px;
}

/* --- chrome --------------------------------------------------------- */

QToolBar {
    background: $surface;
    border: none;
    border-bottom: ${border_w}px solid $border;
    spacing: ${s1}px;
    padding: 4px ${s1}px;
}
QToolButton { border: ${border_w}px solid transparent; border-radius: ${radius}px; padding: 4px; }
QToolButton:hover { border-color: $border; background: $bg; }
QToolButton:checked { background: $bg; border-color: $border; }

QStatusBar {
    background: $surface;
    border-top: ${border_w}px solid $border;
    color: $text_muted;
}
QStatusBar QLabel { color: $text_muted; font-size: ${size_label}px; padding: 0px ${s1}px; }
QStatusBar::item { border: none; }

QProgressBar#busy { background: $border; border: none; max-height: 3px; min-height: 3px; }
QProgressBar#busy::chunk { background: $accent; }

QTabWidget::pane { border: none; background: $surface; }
QTabBar::tab {
    background: transparent;
    padding: 6px ${s2}px;
    border: none;
    border-bottom: 2px solid transparent;
    color: $text_muted;
}
QTabBar::tab:selected { color: $text; border-bottom: 2px solid $accent; }

QToolTip {
    background: $surface;
    color: $text;
    border: ${border_w}px solid $border;
    padding: 4px;
}

QScrollBar:vertical { background: $surface; width: ${s1}px; margin: 0px; border: none; }
QScrollBar::handle:vertical { background: $border; border-radius: 3px; min-height: ${s3}px; }
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* --- inlet canvas ---------------------------------------------------- */

#hoverCard {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
}
#hoverTitle { font-weight: 600; color: $text; padding-bottom: 2px; }
#hoverNote { color: $text_muted; font-style: italic; padding-top: 2px; }

#canvasOverlay {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
    padding: ${s1}px ${s2}px;
    color: $text_muted;
}
#canvasOverlay[error="true"] { color: $error; border-color: $error; }

#selectionHint { color: $text_muted; font-size: ${size_label}px; }
QToolButton#layerToggle { padding: 4px ${s1}px; color: $text_muted; }
QToolButton#layerToggle:checked { color: $text; }

/* --- M8.2 layout ------------------------------------------------------ */

#viewRow { background: $surface; border-bottom: ${border_w}px solid $border; }
#infoBanner {
    background: $surface;
    border-bottom: ${border_w}px solid $border;
    border-left: 3px solid $warn;
}
#infoBannerText { color: $text; }
#bannerClose { color: $text_muted; border: none; padding: 2px 6px; }
QTabBar#mainTabs { background: transparent; }
QTabBar#mainTabs::tab { padding: 6px ${s2}px; }
#tabSubtitle { color: $text_muted; }
#chartsBar {
    border: none;
    border-top: ${border_w}px solid $border;
    border-radius: 0px;
    background: $surface;
    color: $text;
    font-weight: 600;
    text-align: left;
    padding: 6px ${s2}px;
}
#chartsBar:hover { background: $bg; }

/* --- M8.2 results / warnings ----------------------------------------------- */
#warningBanner {
    text-align: left;
    color: $text;
    background: $surface;
    border: ${border_w}px solid $warn;
    border-left: 3px solid $warn;
    border-radius: ${radius}px;
    padding: 6px ${s1}px;
}
#warningBanner:hover { background: $bg; }
#noticeGroup { color: $text; font-size: ${size_base}px; font-weight: 600; padding-top: 4px; }
#warningItem {
    background: $surface;
    border: ${border_w}px solid $border;
    border-radius: ${radius}px;
}
#warningItem[level="warn"] { border-left: 3px solid $warn; }
#warningItem[level="error"] { border-left: 3px solid $error; }
#warningItem[level="info"] { border-left: 3px solid $accent; }
#warningHead { color: $text; }
#warningItem:focus { border-color: $accent; }
#warningBody { color: $text; padding: 0px 0px 2px 22px; }
#exportButton {
    background: $surface;
    color: $text;
    border: ${border_w}px solid $accent;
    border-radius: ${radius}px;
    padding: 7px ${s2}px;
    font-weight: 600;
}
#exportButton:hover { background: $bg; }
#exportButton::menu-indicator { subcontrol-position: right center; right: ${s1}px; }
